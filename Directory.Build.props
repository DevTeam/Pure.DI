<Project>

    <PropertyGroup>
        <VersionRange>2.5.*</VersionRange>
        <InternalVersion>2.5.11</InternalVersion>
        <BasePackageId>Pure.DI</BasePackageId>
        <LangVersion>latest</LangVersion>
        <!--Make sure that Build.Settings.BaseDotNetFrameworkMajorVersion has been updated.-->
        <BaseTargetFramework>net11.0</BaseTargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/DevTeam/Pure.DI.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/DevTeam/Pure.DI/</PackageProjectUrl>
        <PackageTags>ioc;solid;dotnet;dependency-injection;inversion-of-control;di;injection-container;injection-framework;dip;csharp-sourcegenerator</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Coding in a pure DI paradigm without frameworks!</Description>
        <Product>$(BasePackageId)</Product>
        <Copyright>Copyright (C) $([System.DateTime]::Now.Year) Nikolay Pianikov</Copyright>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImmutypeAPI>False</ImmutypeAPI>
        <NoWarn>NETSDK1215;NETSDK1057;NU3005;NU5128;NU1108;CS1591;CS8321;CA1050;NU1801;NU1901;NU1903</NoWarn>

        <!--
        <AnalyzerRoslynVersion Condition="'$(AnalyzerRoslynVersion)'==''">4.3</AnalyzerRoslynVersion>
        <AnalyzerRoslynPackageVersion Condition="'$(AnalyzerRoslynPackageVersion)'==''">4.3.1</AnalyzerRoslynPackageVersion>
        <RoslynVersions Condition="'$(RoslynVersions)'==''">ROSLYN4_3_OR_GREATER</RoslynVersions>
        -->

        <AnalyzerRoslynVersion Condition="'$(AnalyzerRoslynVersion)'==''">5.12</AnalyzerRoslynVersion>
        <AnalyzerRoslynPackageVersion Condition="'$(AnalyzerRoslynPackageVersion)'==''">5.12.0</AnalyzerRoslynPackageVersion>
        <!--
        The Roslyn API levels used by the '#if ROSLYN*_OR_GREATER' directives of the sources and tests.
        Every supported gate must be listed here, otherwise the code behind it is never compiled, and for the
        Roslyn 5.12 compiler all of them are supported. A level must be a Roslyn version that actually exists on
        NuGet, otherwise the CI build of that version cannot define it. The build passes the levels of the Roslyn
        version it builds, so keep this list in sync with GeneratorTarget.RoslynApiLevels.
        -->
        <RoslynVersions Condition="'$(RoslynVersions)'==''">ROSLYN5_9_OR_GREATER;ROSLYN4_8_OR_GREATER;ROSLYN4_3_OR_GREATER</RoslynVersions>

        <DefineConstants>$(DefineConstants);$(RoslynVersions)</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="ImmutypeAPI"/>
    </ItemGroup>

</Project>

