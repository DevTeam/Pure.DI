<#@ template language="C#" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ parameter name="Profile" type="System.String" #>
<#@ parameter name="BindingCount" type="System.Int32" #>
<#@ parameter name="RootCount" type="System.Int32" #>
<#@ parameter name="DeclarationCount" type="System.Int32" #>
<#
    // This workload intentionally stays outside the main solution. These values
    // create a large, connected graph suitable for generator profiling.
    var profile = string.IsNullOrWhiteSpace(Profile) ? "AllPatterns" : Profile;
    var requestedBindingCount = BindingCount > 0 ? BindingCount : 1311;
    var requestedRootCount = RootCount > 0 ? RootCount : 28;
    var requestedDeclarationCount = DeclarationCount > 0 ? DeclarationCount : 2560;
    var includeBulk = profile is "AllPatterns" or "Bindings" or "Roots";
    var includeFeatures = profile is "AllPatterns";
    var moduleCount = profile switch
    {
        "Bindings" => System.Math.Max(1, (requestedBindingCount - 20 + 62) / 63),
        "Roots" => 2,
        "AllPatterns" => 20,
        _ => 0
    };
    const int useCasesPerModule = 10;
    const int repositoriesPerModule = 6;
    const int validatorsPerUseCase = 4;
    const int policiesPerModule = 5;
    const int setupGroupCount = 4;

    var bindingCount = 0;
    var rootCount = 0;
    var declarationCount = 0;
    var bindings = new StringBuilder();
    var setupBindings = new StringBuilder[setupGroupCount];
    for (var setupGroup = 0; setupGroup < setupGroupCount; setupGroup++)
    {
        setupBindings[setupGroup] = new StringBuilder();
    }
    var currentSetupGroup = 0;
    var declarations = new StringBuilder();
    var declarationProfileTypes = new List<KeyValuePair<string, List<string>>>();
    var declarationProfileRoot = "DeclarationProfileService0";
    if (profile == "Declarations")
    {
        var typeCount = System.Math.Max(1, requestedDeclarationCount);
        for (var declaration = 0; declaration < typeCount; declaration++)
        {
            var name = $"DeclarationProfileService{declaration}";
            var dependencies = new List<string>();
            for (var child = 8 * declaration + 1;
                 child < System.Math.Min(typeCount, 8 * declaration + 9);
                 child++)
            {
                dependencies.Add($"DeclarationProfileService{child}");
            }

            declarationProfileTypes.Add(new KeyValuePair<string, List<string>>(name, dependencies));
        }
    }

    string LifetimeFor(int index)
    {
        return (index % 5) switch
        {
            0 => "Lifetime.Singleton",
            1 => "Lifetime.PerBlock",
            2 => "Lifetime.Transient",
            3 => "Lifetime.PerResolve",
            _ => "Lifetime.Transient"
        };
    }

    void AppendBinding(string contract, string implementation, string lifetime)
    {
        bindingCount++;
        setupBindings[currentSetupGroup].AppendLine($"        .Bind<{contract}>().As({lifetime}).To<{implementation}>()");
    }

    void AppendRoot(string contract, string name)
    {
        rootCount++;
        bindings.AppendLine($"        .Root<{contract}>(\"{name}\")");
    }

    void AppendService(string contract, string implementation, string parameters, string lifetime)
    {
        AppendBinding(contract, implementation, lifetime);
        declarationCount += 2;
        declarations.AppendLine($"public interface {contract};");
        declarations.AppendLine($"public class {implementation}({parameters}) : {contract};");
        declarations.AppendLine();
    }

    void AppendLeafService(string contract, string implementation, string lifetime)
    {
        AppendService(contract, implementation, "", lifetime);
    }

    var sharedServices = new List<string[]>
    {
        new[] { "IClock", "SystemClock", "Lifetime.Singleton" },
        new[] { "IAppLogger", "StructuredLogger", "Lifetime.Singleton" },
        new[] { "IMetrics", "Metrics", "Lifetime.Singleton" },
        new[] { "ITracer", "Tracer", "Lifetime.Singleton" },
        new[] { "IMessageBus", "MessageBus", "Lifetime.Singleton" },
        new[] { "IEventPublisher", "EventPublisher", "Lifetime.PerBlock" },
        new[] { "IDatabase", "Database", "Lifetime.Singleton" },
        new[] { "IConnectionFactory", "ConnectionFactory", "Lifetime.Singleton" },
        new[] { "IQueryCompiler", "QueryCompiler", "Lifetime.Singleton" },
        new[] { "ICache", "MemoryCache", "Lifetime.Singleton" },
        new[] { "ITransaction", "Transaction", "Lifetime.PerBlock" },
        new[] { "IRetryPolicy", "RetryPolicy", "Lifetime.Singleton" },
        new[] { "IFeatureFlags", "FeatureFlags", "Lifetime.Singleton" },
        new[] { "IObjectMapper", "ObjectMapper", "Lifetime.Singleton" },
        new[] { "IRuleCatalog", "RuleCatalog", "Lifetime.Singleton" },
        new[] { "IAuthorization", "Authorization", "Lifetime.PerBlock" },
        new[] { "ISettings", "Settings", "Lifetime.Singleton" },
        new[] { "IRequestContext", "RequestContext", "Lifetime.PerBlock" }
    };

    if (includeBulk || includeFeatures)
    {
        foreach (var service in sharedServices)
        {
            AppendLeafService(service[0], service[1], service[2]);
        }

        AppendService(
            "IAuditTrail",
            "AuditTrail",
            "IClock clock, IAppLogger logger, IEventPublisher events, IRequestContext requestContext",
            "Lifetime.PerBlock");
    }

    for (var module = 0; module < moduleCount; module++)
    {
        currentSetupGroup = module % setupGroupCount;
        var moduleFacadeContract = $"IModule{module}Facade";
        AppendService(
            $"IModule{module}Audit",
            $"Module{module}Audit",
            "IAuditTrail auditTrail, IAppLogger logger, IMetrics metrics, IRequestContext requestContext",
            "Lifetime.PerBlock");

        for (var policy = 0; policy < policiesPerModule; policy++)
        {
            AppendService(
                $"IModule{module}Policy{policy}",
                $"Module{module}Policy{policy}",
                "IFeatureFlags featureFlags, IAuthorization authorization, ISettings settings, IRequestContext requestContext",
                LifetimeFor(module + policy));
        }

        for (var repository = 0; repository < repositoriesPerModule; repository++)
        {
            AppendService(
                $"IModule{module}Repository{repository}",
                $"Module{module}Repository{repository}",
                "IDatabase database, IConnectionFactory connectionFactory, IQueryCompiler queryCompiler, ICache cache, IAppLogger logger, IMetrics metrics, ITracer tracer, IRetryPolicy retryPolicy, IClock clock",
                LifetimeFor(module + repository + 1));
        }

        for (var useCase = 0; useCase < useCasesPerModule; useCase++)
        {
            for (var validator = 0; validator < validatorsPerUseCase; validator++)
            {
                AppendService(
                    $"IModule{module}UseCase{useCase}Validator{validator}",
                    $"Module{module}UseCase{useCase}Validator{validator}",
                    "IRuleCatalog ruleCatalog, ISettings settings, IClock clock, IAppLogger logger, IRequestContext requestContext",
                    LifetimeFor(module + useCase + validator));
            }

            var useCaseParameters = new List<string>
            {
                $"IModule{module}Repository{useCase % repositoriesPerModule} primaryRepository",
                $"IModule{module}Repository{(useCase + 1) % repositoriesPerModule} secondaryRepository",
                $"IModule{module}Repository{(useCase + 2) % repositoriesPerModule} archiveRepository",
                $"IModule{module}Policy{useCase % policiesPerModule} policy",
                $"IModule{module}Policy{(useCase + 1) % policiesPerModule} fallbackPolicy",
                $"IModule{module}UseCase{useCase}Validator0 validator0",
                $"IModule{module}UseCase{useCase}Validator1 validator1",
                $"IModule{module}UseCase{useCase}Validator2 validator2",
                $"IModule{module}Audit audit",
                "IObjectMapper mapper",
                "ITransaction transaction",
                "IEventPublisher events",
                "IMessageBus messageBus",
                "IAppLogger logger",
                "IMetrics metrics",
                "ITracer tracer",
                "IClock clock",
                "IRequestContext requestContext"
            };

            AppendService(
                $"IModule{module}UseCase{useCase}",
                $"Module{module}UseCase{useCase}",
                string.Join(", ", useCaseParameters),
                LifetimeFor(module + useCase + 2));
        }

        var facadeParameters = new List<string>();
        for (var useCase = 0; useCase < useCasesPerModule; useCase++)
        {
            facadeParameters.Add($"IModule{module}UseCase{useCase} useCase{useCase}");
        }

        facadeParameters.Add($"IModule{module}Audit audit");
        facadeParameters.Add("IAppLogger logger");
        facadeParameters.Add("IMetrics metrics");
        facadeParameters.Add("ITracer tracer");

        AppendService(
            moduleFacadeContract,
            $"Module{module}Facade",
            string.Join(", ", facadeParameters),
            "Lifetime.PerBlock");

        if (profile is "AllPatterns" or "Bindings")
        {
            AppendRoot(moduleFacadeContract, $"Module{module}");
        }
    }

    var applicationParameters = new List<string>();
    for (var module = 0; module < moduleCount; module++)
    {
        applicationParameters.Add($"IModule{module}Facade module{module}");
    }

    applicationParameters.Add("IMessageBus messageBus");
    applicationParameters.Add("IEventPublisher events");
    applicationParameters.Add("IAuditTrail auditTrail");
    applicationParameters.Add("IAppLogger logger");
    applicationParameters.Add("IMetrics metrics");
    applicationParameters.Add("ITracer tracer");
    applicationParameters.Add("IClock clock");
    applicationParameters.Add("IRequestContext requestContext");

    if (includeBulk && profile != "Bindings")
    {
        currentSetupGroup = 0;
        AppendService(
            "IApplication",
            "Application",
            string.Join(", ", applicationParameters),
            "Lifetime.PerBlock");
    }

    // Feature islands keep the workload application-shaped while covering
    // substantially more Pure.DI code-generation paths than the bulk graph.
    if (includeFeatures)
    {
    bindings.AppendLine("        .Bind<IFeaturePlugin>(\"primary\", default).To<PrimaryFeaturePlugin>()");
    bindings.AppendLine("        .Bind<IFeaturePlugin>(\"secondary\").To<SecondaryFeaturePlugin>()");
    bindings.AppendLine("        .Bind<IFeatureRepository<TT>>().As(Lifetime.PerBlock).To<FeatureRepository<TT>>()");
    bindings.AppendLine("        .Bind<IFeatureReader, IFeatureWriter, FeatureStore>().As(Lifetime.PerBlock).To<FeatureStore>()");
    bindings.AppendLine("        .Bind<string>(\"feature-format\").To(() => \"json\")");
    bindings.AppendLine("        .Bind<IFeatureFormatter>().To((FeatureFormatter formatter, [Tag(\"feature-format\")] string format) => { formatter.Initialize(format); return formatter; })");
    bindings.AppendLine("        .Bind<IFeatureConnection>().To<FeatureConnection>(ctx => { ctx.Inject(out FeatureConnection connection); connection.Open(); return connection; })");
    bindings.AppendLine("        .Bind<IFeatureCommand>(\"core\").To<CoreFeatureCommand>()");
    bindings.AppendLine("        .Bind<IFeatureCommand>().To<LoggingFeatureCommand>()");
    bindings.AppendLine("        .Bind().To<FeatureLeaf>()");
    bindings.AppendLine("        .Bind<IFeatureLeaf>(\"wrapped\").To<FeatureLeaf>()");
    bindings.AppendLine("        .Bind<IFeatureParameterized>().To<FeatureParameterized>()");
    bindings.AppendLine("        .Bind(Tag.Unique).To((EmailFeatureChannel channel) => new KeyValuePair<FeatureChannel, IFeatureChannel>(FeatureChannel.Email, channel))");
    bindings.AppendLine("        .Bind(Tag.Unique).To((QueueFeatureChannel channel) => new KeyValuePair<FeatureChannel, IFeatureChannel>(FeatureChannel.Queue, channel))");
    bindings.AppendLine("        .Bind().To(Guid.NewGuid)");
    bindings.AppendLine("        .Bind().To<FeatureWeapon>()");
    bindings.AppendLine("        .Bind().To(ctx => { var instance = new FeatureBuildUp(); ctx.BuildUp(instance); return instance; })");
    bindings.AppendLine("        .Bind().To<FeatureEnvironment>()");
    bindings.AppendLine("        .Bind().To<FeatureMemberInjected>()");
    bindings.AppendLine("        .Bind().To<FeatureOptionalConsumer>()");
    bindings.AppendLine("        .Bind().To<FeatureLifetimeProbe>()");
    bindings.AppendLine("        .Bind().To<FeatureTransient>()");
    bindings.AppendLine("        .Bind().As(Lifetime.PerBlock).To<FeaturePerBlock>()");
    bindings.AppendLine("        .Bind().As(Lifetime.PerResolve).To<FeaturePerResolve>()");
    bindings.AppendLine("        .Bind().As(Lifetime.Singleton).To<FeatureSingleton>()");
    bindings.AppendLine("        .Bind().As(Lifetime.Singleton).To<FeatureDisposableSingleton>()");
    bindings.AppendLine("        .Bind().To<FeatureDisposableOperation>()");
    bindings.AppendLine("        .Bind().To<FeatureAsyncDisposableOperation>()");
    bindings.AppendLine("        .Bind<IFeatureOwnedHandler>().To<FeatureOwnedHandler>()");
    bindings.AppendLine("        .Bind().To<FeatureDashboard>()");
    bindings.AppendLine("        .Bind().To<FeatureAnonymous>()");
    bindings.AppendLine("        .Arg<string>(\"environmentName\", \"environment\")");
    bindings.AppendLine("        .Builder<FeatureBuildTarget>(\"BuildFeatureTarget\")");
    bindingCount += 31;

    AppendRoot("FeatureDashboard", "Features");
    bindings.AppendLine("        .Root<IFeaturePlugin>(\"SecondaryPlugin\", \"secondary\")");
    bindings.AppendLine("        .Root<Owned<IFeatureOwnedHandler>>(\"OwnedHandler\", kind: RootKinds.Internal)");
    bindings.AppendLine("        .Root<FeatureStaticLeaf>(\"StaticLeaf\", kind: RootKinds.Internal | RootKinds.Static)");
    bindings.AppendLine("        .Root<IFeatureLeaf>(\"GetFeatureLeaf\", kind: RootKinds.Public | RootKinds.Method)");
    bindings.AppendLine("        .Root<IFeatureLeaf>(\"GetPrivateFeatureLeaf\", \"wrapped\", RootKinds.Private | RootKinds.Partial | RootKinds.Method)");
    bindings.AppendLine("        .Root<FeatureAnonymous>()");
    rootCount += 6;
    }

    if (includeBulk)
    {
        if (profile == "Roots")
        {
            for (var root = 0; root < requestedRootCount; root++)
            {
                AppendRoot($"RootProfile{root}", $"Application{root}");
            }
        }
        else if (profile != "Bindings")
        {
            AppendRoot("IApplication", "Application");
        }
    }

    if (profile == "Declarations")
    {
        rootCount = 1;
        declarationCount = declarationProfileTypes.Count;
    }
    else if (profile == "FactoriesAndTags")
    {
        var itemCount = System.Math.Max(1, (requestedBindingCount - 1) / 2);
        bindingCount = 1 + 2 * itemCount;
        rootCount = 1;
        declarationCount = 3 + 2 * itemCount;
    }
    else if (profile == "ScopesAndAccumulators")
    {
        bindingCount = requestedBindingCount + 1;
        rootCount = 1;
        declarationCount = requestedBindingCount + 3;
    }
    else if (profile == "GenericsAndVariants")
    {
        var variantCount = System.Math.Max(1, requestedBindingCount - 1);
        bindingCount = 1 + variantCount;
        rootCount = 1;
        declarationCount = 3 + 2 * variantCount;
    }
#>
// ReSharper disable InconsistentNaming
// ReSharper disable EmptyConstructor
// ReSharper disable UnusedMember.Local
// ReSharper disable ClassNeverInstantiated.Global
// ReSharper disable UnusedType.Global
#pragma warning disable CS9113 // Parameter is unread.

namespace HugeComposition;

using Pure.DI;
using System;
using System.Collections.Generic;
using System.Threading.Tasks;

// Modules: <#= moduleCount #>
// Main setup bindings: <#= bindingCount #>
// Main setup roots: <#= rootCount #>
// Bulk service declarations: <#= declarationCount #>
// Additional feature compositions: <#= includeFeatures ? 4 : 0 #>

<# if (includeBulk || includeFeatures) { #>
[System.Diagnostics.CodeAnalysis.SuppressMessage("Performance", "CA1822:Mark members as static")]
public partial class Composition
{
    private void Setup() => DI.Setup()
<# if (includeFeatures) { #>
        .DependsOn("HugeSharedFeatures")
<# } #>
<# if (includeBulk) { #>
<# for (var setupGroup = 0; setupGroup < setupGroupCount; setupGroup++) { #>
        .DependsOn("HugeBulkGroup<#= setupGroup #>")
<# } #>
<# } #>
<#= bindings.ToString().TrimEnd() #>;

<# if (includeFeatures) { #>
    private partial IFeatureLeaf GetPrivateFeatureLeaf();

    public IFeatureLeaf WrappedFeatureLeaf => GetPrivateFeatureLeaf();
<# } #>
}
<# } #>

<# if (includeBulk) { #>
<# for (var setupGroup = 0; setupGroup < setupGroupCount; setupGroup++) { #>
internal static class HugeBulkGroup<#= setupGroup #>Setup
{
    private static void Setup() =>
        DI.Setup("HugeBulkGroup<#= setupGroup #>", CompositionKind.Internal)
<#= setupBindings[setupGroup].ToString().TrimEnd() #>;
}

<# } #>
<# } #>
<#= declarations.ToString() #>
<# if (profile == "Roots") { #>
<# for (var root = 0; root < requestedRootCount; root++) { #>
public sealed class RootProfile<#= root #>(IApplication application);
<# } #>
<# } #>

// Feature: dependent setup.
<# if (includeFeatures) { #>
internal static class HugeSharedFeatureSetup
{
    private static void Setup() =>
        DI.Setup("HugeSharedFeatures", CompositionKind.Internal)
            .Bind<ISharedFeatureSeed>().As(Lifetime.Singleton).To<SharedFeatureSeed>();
}

public interface ISharedFeatureSeed;

public sealed class SharedFeatureSeed : ISharedFeatureSeed;

// Feature: tags, default selection, multi-bindings and collections.
public interface IFeaturePlugin;

public sealed class PrimaryFeaturePlugin : IFeaturePlugin;

public sealed class SecondaryFeaturePlugin : IFeaturePlugin;

// Feature: marker-based generic binding with several closed usages.
public interface IFeatureRepository<T>;

public sealed class FeatureRepository<T>(ISharedFeatureSeed seed) : IFeatureRepository<T>;

public sealed record FeatureCustomer;

public sealed record FeatureOrder;

// Feature: one implementation explicitly satisfies several contracts.
public interface IFeatureReader;

public interface IFeatureWriter;

public sealed class FeatureStore(ISharedFeatureSeed seed)
    : IFeatureReader, IFeatureWriter;

// Feature: context and simplified factories.
public interface IFeatureFormatter
{
    string Format { get; }
}

public sealed class FeatureFormatter : IFeatureFormatter
{
    public string Format { get; private set; } = "";

    public void Initialize(string format) => Format = format;
}

public interface IFeatureConnection
{
    bool IsOpen { get; }
}

public sealed class FeatureConnection(ISharedFeatureSeed seed) : IFeatureConnection
{
    public bool IsOpen { get; private set; }

    public void Open() => IsOpen = true;
}

// Feature: a tagged decorator chain.
public interface IFeatureCommand;

public sealed class CoreFeatureCommand : IFeatureCommand;

public sealed class LoggingFeatureCommand(
    [Tag("core")] IFeatureCommand inner,
    IFeatureFormatter formatter)
    : IFeatureCommand;

// Feature: deferred and BCL-provided dependency shapes.
public interface IFeatureLeaf;

public sealed class FeatureLeaf : IFeatureLeaf;

public sealed class FeatureBclShapes(
    Lazy<IFeatureLeaf> lazyLeaf,
    Func<IFeatureLeaf> leafFactory,
    Func<int, string, IFeatureParameterized> parameterizedFactory,
    Task<IFeatureLeaf> leafTask,
    ValueTask<IFeatureLeaf> leafValueTask,
    (IFeatureLeaf Left, IFeatureLeaf Right) leaves,
    IReadOnlyDictionary<FeatureChannel, IFeatureChannel> channels);

public interface IFeatureParameterized;

public sealed class FeatureParameterized(
    int id,
    string name,
    ISharedFeatureSeed seed)
    : IFeatureParameterized;

public enum FeatureChannel
{
    Email,
    Queue
}

public interface IFeatureChannel;

public sealed class EmailFeatureChannel : IFeatureChannel;

public sealed class QueueFeatureChannel : IFeatureChannel;

// Feature: BuildUp and generated Builder entry points.
public interface IFeatureWeapon;

public sealed class FeatureWeapon : IFeatureWeapon;

public sealed class FeatureBuildUp
{
    [Dependency]
    public IFeatureWeapon Weapon { get; set; } = null!;

    public Guid Id { get; private set; }

    [Dependency(ordinal: 1)]
    public void SetId(Guid id) => Id = id;
}

public sealed class FeatureBuildTarget
{
    [Dependency]
    public IFeatureWeapon Weapon { get; set; } = null!;

    public Guid Id { get; private set; }

    [Dependency(ordinal: 1)]
    public void SetId(Guid id) => Id = id;
}

// Feature: composition and root arguments.
public sealed class FeatureEnvironment(
    [Tag("environment")] string environmentName);

public sealed class FeatureOperation(
    [Tag("operation")] Guid operationId);

// Feature: property, field and method injection.
public sealed class FeatureMemberInjected
{
    [Dependency]
    public IFeatureConnection Connection { get; set; } = null!;

    [Dependency(ordinal: 1)]
    public IFeatureFormatter Formatter = null!;

    public ISharedFeatureSeed? Seed { get; private set; }

    [Dependency(ordinal: 2)]
    public void Initialize(ISharedFeatureSeed seed) => Seed = seed;
}

// Feature: a missing optional abstraction is supplied by the default value.
public interface IFeatureOptional;

public sealed class FeatureOptionalConsumer(IFeatureOptional? optional = null);

// Feature: all principal non-scoped reuse boundaries in one observable graph.
public sealed class FeatureTransient;

public sealed class FeaturePerBlock;

public sealed class FeaturePerResolve;

public sealed class FeatureSingleton;

public sealed class FeatureLifetimeProbe(
    FeatureTransient transient1,
    FeatureTransient transient2,
    FeaturePerBlock perBlock1,
    FeaturePerBlock perBlock2,
    FeaturePerResolve perResolve1,
    FeaturePerResolve perResolve2,
    FeatureSingleton singleton1,
    FeatureSingleton singleton2);

// Feature: synchronous/asynchronous disposal and explicit root ownership.
public sealed class FeatureDisposableSingleton : IDisposable
{
    public void Dispose() { }
}

public sealed class FeatureDisposableOperation : IDisposable
{
    public void Dispose() { }
}

public sealed class FeatureAsyncDisposableOperation : IAsyncDisposable
{
    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

public interface IFeatureOwnedHandler;

public sealed class FeatureOwnedHandler(
    FeatureDisposableOperation disposable,
    FeatureAsyncDisposableOperation asyncDisposable)
    : IFeatureOwnedHandler;

// Feature: attribute-declared tagged singleton binding.
public interface IFeatureAttributed;

[Bind(typeof(IFeatureAttributed), Lifetime.Singleton, "attribute")]
public sealed class FeatureAttributed : IFeatureAttributed;

// Feature: a high-connectivity facade makes every feature binding reachable.
public sealed class FeatureDashboard(
    ISharedFeatureSeed sharedSeed,
    IEnumerable<IFeaturePlugin> plugins,
    IFeaturePlugin[] pluginArray,
    IFeatureRepository<FeatureCustomer> customers,
    IFeatureRepository<FeatureOrder> orders,
    IFeatureReader reader,
    IFeatureWriter writer,
    IFeatureFormatter formatter,
    IFeatureConnection connection,
    IFeatureCommand command,
    FeatureBclShapes bclShapes,
    FeatureEnvironment environment,
    FeatureMemberInjected memberInjected,
    FeatureBuildUp builtUp,
    FeatureOptionalConsumer optionalConsumer,
    FeatureLifetimeProbe lifetimes,
    FeatureDisposableSingleton disposableSingleton,
    [Tag("attribute")] IFeatureAttributed attributed);

public sealed class FeatureAnonymous(FeatureDashboard dashboard);

public sealed class FeatureStaticLeaf;

// Feature: Scoped lifetime through a composition-derived request scope.
public interface IFeatureScopedContext;

public sealed class FeatureScopedContext : IFeatureScopedContext, IDisposable
{
    public void Dispose() { }
}

public sealed class FeatureScopedService(
    IFeatureScopedContext context1,
    IFeatureScopedContext context2);

public sealed class FeatureRequestScope(FeatureScopedComposition parent)
    : FeatureScopedComposition(parent);

public sealed class FeatureScopeHost(Func<FeatureRequestScope> scopeFactory);

public partial class FeatureScopedComposition
{
    private static void Setup() =>
        DI.Setup()
            .Bind().As(Lifetime.Scoped).To<FeatureScopedContext>()
            .Bind().To<FeatureScopedService>()
            .Root<FeatureScopedService>("Request")
            .Root<FeatureScopeHost>("ScopeHost");
}

// Feature: generation hints are isolated because they affect a whole composition.
public partial class FeatureHintComposition
{
    private static void Setup() =>
        DI.Setup()
            .Hint(Hint.Resolve, "Off")
            .Hint(Hint.ThreadSafe, "Off")
            .Bind().To<FeatureHintLeaf>()
            .Root<FeatureHintLeaf>("Root");
}

public sealed class FeatureHintLeaf;

// Feature: root arguments are isolated from Resolve because dynamic resolution
// cannot provide per-call root arguments.
public partial class FeatureArgumentComposition
{
    private static void Setup() =>
        DI.Setup()
            .Hint(Hint.Resolve, "Off")
            .RootArg<Guid>("operationId", "operation")
            .Root<FeatureOperation>("CreateOperation");
}

// Feature: asynchronous Task and ValueTask roots, including cancellation flow.
public interface IFeatureAsyncService;

public sealed class FeatureAsyncService(IFeatureLeaf leaf) : IFeatureAsyncService;

public partial class FeatureAsyncComposition
{
    private static void Setup() =>
        DI.Setup()
            .Hint(Hint.Resolve, "Off")
            .RootArg<System.Threading.CancellationToken>("cancellationToken")
            .Bind().To<FeatureLeaf>()
            .Bind<IFeatureAsyncService>().To<FeatureAsyncService>()
            .Root<Task<IFeatureAsyncService>>("GetServiceAsync")
            .Root<ValueTask<IFeatureAsyncService>>("GetServiceValueAsync");
}
<# } #>

<# if (profile == "Declarations") { #>
// Profile: a large auto-binding graph with one root. This isolates the cost
// of discovering and emitting declarations from explicit binding/root volume.
public partial class DeclarationProfileComposition
{
    private static void Setup() =>
        DI.Setup()
            .Root<<#= declarationProfileRoot #>>("Root");
}

<# foreach (var declarationType in declarationProfileTypes) { #>
public sealed class <#= declarationType.Key #><# if (declarationType.Value.Count > 0) { #>(<# for (var dependency = 0; dependency < declarationType.Value.Count; dependency++) { if (dependency > 0) { #>, <# } #><#= declarationType.Value[dependency] #> dependency<#= dependency #><# } #>)<# } #>;
<# } #>
<# } #>

<# if (profile == "FactoriesAndTags") {
    var factoryItemCount = System.Math.Max(1, (requestedBindingCount - 1) / 2);
#>
// Profile: simplified factories and tagged injection paths.
public partial class FactoryProfileComposition
{
    private static void Setup() =>
        DI.Setup()
            .Bind().As(Lifetime.Singleton).To<FactoryProfileDependency>()
<# for (var item = 0; item < factoryItemCount; item++) { #>
            .Bind<IFactoryProfileItem>(<#= item #>).To((FactoryProfileDependency dependency) => new FactoryProfileItem<#= item #>(dependency))
            .Bind<IFactoryProfileConsumer>(Tag.Unique).To<FactoryProfileConsumer<#= item #>>()
<# } #>
            .Root<IFactoryProfileConsumer[]>("Root");
}

public sealed class FactoryProfileDependency;

public interface IFactoryProfileItem;

public interface IFactoryProfileConsumer;
<# for (var item = 0; item < factoryItemCount; item++) { #>
public sealed class FactoryProfileItem<#= item #>(FactoryProfileDependency dependency) : IFactoryProfileItem;

public sealed class FactoryProfileConsumer<#= item #>([Tag(<#= item #>)] IFactoryProfileItem item) : IFactoryProfileConsumer;
<# } #>
<# } #>

<# if (profile == "ScopesAndAccumulators") { #>
// Profile: scoped instances collected through an accumulator.
public partial class ScopeAccumulatorProfileComposition
{
    private static void Setup() =>
        DI.Setup()
<# for (var item = 0; item < requestedBindingCount; item++) { #>
            .Bind<IScopeProfileTelemetry>(Tag.Unique).As(Lifetime.Scoped).To<ScopeProfileTelemetry<#= item #>>()
<# } #>
            .Bind().To<ScopeProfileConsumer>()
            .Accumulate<IScopeProfileTelemetry, ScopeProfileAccumulator>(Lifetime.Scoped)
            .Root<(ScopeProfileConsumer Consumer, ScopeProfileAccumulator Accumulator)>("Root");
}

public interface IScopeProfileTelemetry;

public sealed class ScopeProfileAccumulator : List<IScopeProfileTelemetry>;

public sealed class ScopeProfileConsumer(IEnumerable<IScopeProfileTelemetry> telemetry);
<# for (var item = 0; item < requestedBindingCount; item++) { #>
public sealed class ScopeProfileTelemetry<#= item #> : IScopeProfileTelemetry;
<# } #>
<# } #>

<# if (profile == "GenericsAndVariants") {
    var genericVariantCount = System.Math.Max(1, requestedBindingCount - 1);
#>
// Profile: one marker-based generic binding expanded into many closed graphs.
public partial class GenericVariantProfileComposition
{
    private static void Setup() =>
        DI.Setup()
            .Bind<IGenericProfileRepository<TT>>().As(Lifetime.PerBlock).To<GenericProfileRepository<TT>>()
<# for (var item = 0; item < genericVariantCount; item++) { #>
            .Bind<IGenericProfileVariant>(Tag.Unique).To<GenericProfileVariant<#= item #>>()
<# } #>
            .Root<IGenericProfileVariant[]>("Root");
}

public interface IGenericProfileRepository<T>;

public sealed class GenericProfileRepository<T> : IGenericProfileRepository<T>;

public interface IGenericProfileVariant;
<# for (var item = 0; item < genericVariantCount; item++) { #>
public sealed class GenericProfileToken<#= item #>;

public sealed class GenericProfileVariant<#= item #>(IGenericProfileRepository<GenericProfileToken<#= item #>> repository) : IGenericProfileVariant;
<# } #>
<# } #>
